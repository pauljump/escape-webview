{
  "name": "escape-hatch",
  "version": "0.1.0",
  "description": "Break out of in-app browsers (X, Instagram, Facebook, TikTok, ...) into the user's real browser -- or show a one-tap fallback when the OS forbids it.",
  "main": "src/escape-hatch.js",
  "module": "src/escape-hatch.js",
  "unpkg": "src/escape-hatch.js",
  "jsdelivr": "src/escape-hatch.js",
  "files": [
    "src",
    "interstitial",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "serve": "python3 -m http.server 8080"
  },
  "keywords": [
    "in-app-browser",
    "webview",
    "instagram",
    "twitter",
    "x",
    "tiktok",
    "facebook",
    "redirect",
    "deep-link",
    "oauth",
    "share-link"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/escape-hatch.git"
  },
  "homepage": "https://github.com/OWNER/escape-hatch#readme"
}
